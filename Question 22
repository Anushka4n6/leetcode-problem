class Solution {
    void fun (int n, String s, int a, int b, List<String> ans){
        if (a > n || b > n){
            return;
        }
        if (b > a){
            return;
        }
        if (s.length() == 2*n){
            ans.add(s);
            return;
        }
        fun (n, s + '(', a + 1, b, ans);
        fun (n, s + ')', a, b + 1, ans);
    }
    public List<String> generateParenthesis(int n) {
        List<String> ans = new ArrayList<>();
        fun (n, "", 0, 0, ans);
        return ans;
    }
}
